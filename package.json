{
  "name": "ludora",
  "version": "1.0.0",
  "private": true,
  "description": "Ludora: Modern Online Multiplayer Ludo & Classic Board Games Platform",
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:engine": "npm run test --workspace=@snakes/engine",
    "test:ludo": "npm run test --workspace=@snakes/ludo-engine",
    "test:server": "npm run test --workspace=server"
  },
  "keywords": [
    "snakes-and-ladders",
    "multiplayer",
    "websocket",
    "nextjs",
    "game-engine"
  ],
  "author": "",
  "license": "MIT"
}
